# AI Engineering: Zero to Hero Environment Configuration

# Database Configuration (PostgreSQL + pgvector or SQLite fallback)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_engineering
# For zero-Docker local SQLite:
# DATABASE_URL=sqlite:///app/backend/ai_engineering.db

# Redis Caching (Semantic cache & session store)
REDIS_URL=redis://localhost:6379/0

# Local LLM Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Vector DB (Qdrant / Chroma)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
